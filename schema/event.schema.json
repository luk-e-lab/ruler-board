{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruler/event.schema.json",
  "title": "Ruler 이벤트 (<home>/events/<pc>.jsonl 한 줄)",
  "description": "계약 v1.0. 모든 새 줄은 k·t·account·session·pc 필수. 모르는 k·필드는 리더가 무시. 한 줄 4KB 이하.",
  "type": "object",
  "required": ["k", "t", "account", "session", "pc"],
  "properties": {
    "k": { "enum": ["plan", "ask", "decide", "split", "tick", "handoff", "bind", "hplan", "hook", "deliv"] },
    "t": { "type": "string", "format": "date-time" },
    "account": { "type": "string", "pattern": "^([0-9a-f]{8}|local)$", "description": "CLAUDE_CODE_ACCOUNT_UUID의 sha1 앞 8자리, 없으면 local" },
    "session": { "type": "string", "description": "CLAUDE_CODE_HOST_SESSION_ID / CLAUDE_CODE_SESSION_ID / 훅 session_id / proc-<pid>-…" },
    "pc": { "type": "string", "pattern": "^[a-z0-9_-]{1,40}$", "description": "쓴 PC. 파일 이름과 같다" },
    "p": { "type": "string", "description": "프로젝트 id" },
    "a": { "type": "string", "description": "에이전트 표시 이름. 웹 결정은 user(web)" },
    "majors": { "type": "array", "items": { "type": "string" } },
    "note": { "type": "string" },
    "text": { "type": "string" },
    "target": { "type": "string" },
    "id": { "type": "string", "description": "M1 / M1.2 / A1" },
    "ok": { "type": "boolean" },
    "major": { "type": "string" },
    "add": { "type": "array", "items": { "type": "string" } },
    "drop": { "type": "array", "items": { "type": "string" } },
    "st": { "enum": ["wait", "doing", "done", "blocked"] },
    "to": { "type": "string" },
    "from": { "type": "string" },
    "via": { "enum": ["ruler", "message", "session", "agent"] },
    "cwd": { "type": "string" },
    "items": { "type": "array", "items": { "type": "object", "required": ["title", "st"], "properties": { "title": { "type": "string" }, "st": { "enum": ["pending", "in_progress", "completed"] } } } },
    "advance": { "type": "boolean" },
    "done": { "type": "array", "items": { "type": "integer" } },
    "start": { "type": "integer" },
    "wrap": { "type": "boolean" },
    "ev": { "type": "string", "description": "훅 이벤트 이름" },
    "tool": { "type": "string" },
    "info": { "type": "string" },
    "notable": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "k": { "const": "plan" } } }, "then": { "required": ["p", "majors"] } },
    { "if": { "properties": { "k": { "const": "ask" } } }, "then": { "required": ["p", "text"] } },
    { "if": { "properties": { "k": { "const": "decide" } } }, "then": { "required": ["p", "id", "ok"] } },
    { "if": { "properties": { "k": { "const": "split" } } }, "then": { "required": ["p", "major"] } },
    { "if": { "properties": { "k": { "const": "tick" } } }, "then": { "required": ["p", "id", "st"] } },
    { "if": { "properties": { "k": { "const": "handoff" } } }, "then": { "required": ["to"] } },
    { "if": { "properties": { "k": { "const": "hook" } } }, "then": { "required": ["ev"] } },
    { "if": { "properties": { "k": { "const": "deliv" } } }, "then": { "required": ["p", "id"] } }
  ]
}
